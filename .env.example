NODE_ENV=development
PORT=3000

# 마이그레이션 · 시드 전용 (테이블 소유자)
DATABASE_MIGRATION_URL=postgresql://theoneai_owner:theoneai_owner@localhost:5432/theoneai
# 애플리케이션 (app_rw 역할 계정). 개발 환경에서는 `npm run db:setup` 이 이 계정을 만든다.
DATABASE_URL=postgresql://theoneai_app:theoneai_app@localhost:5432/theoneai

REDIS_URL=redis://localhost:6379

# Secret 저장소. local 은 개발 전용(운영에서는 시작 시 거부) — vault://… 참조를 아래 JSON 에서 찾는다.
# LLM API Key 도 여기에 둔다 (providers.secret_ref 와 같은 키). 실제 키는 .env 에만 넣고 커밋하지 않는다.
#   vault://providers/deepseek   데모 시드의 DeepSeek
#   vault://providers/openai     OpenAI (provider 를 추가했을 때)
#   vault://providers/gemini     Gemini (provider 를 추가했을 때)
SECRETS_BACKEND=local
DEV_SECRETS={"vault://widgets/demo":"dev-widget-secret-change-me","vault://providers/deepseek":"<DEEPSEEK_API_KEY>"}

# 위젯 세션 토큰 서명 키 (ES256, PKCS8 PEM, 줄바꿈은 \n). 개발 환경에서 비우면 임시 키를 만든다.
WIDGET_SESSION_PRIVATE_KEY=
WIDGET_SESSION_TTL_SEC=3600

# 콘솔 access token 서명 키 (ES256, PKCS8 PEM). 위젯 키와 다른 키를 쓴다. 개발 환경에서 비우면 임시 키(재시작하면 다시 로그인).
ADMIN_SESSION_PRIVATE_KEY=
ADMIN_SESSION_TTL_SEC=900
# 시드가 만드는 콘솔 Owner(owner@demo.local)의 비밀번호. 비우면 생성해 한 번만 출력한다.
DEV_ADMIN_PASSWORD=

# 파일 저장소 (Skill 번들 · 이후 산출물). local = 디렉터리, 개발 전용 (production 에서는 S3 — 산출물 단계)
STORAGE_BACKEND=local
OBJECT_STORAGE_DIR=.storage

# 콘솔에서 입력한 Secret(MCP API Key 등)을 개발 환경에서 저장하는 파일 (API · Worker 공유, .gitignore 대상)
LOCAL_SECRETS_FILE=.secrets.local.json

# MCP
#  http:// 엔드포인트 허용 — 개발 전용 (production 에서는 시작 거부, https 만)
MCP_ALLOW_INSECURE_HTTP=false
MCP_CONNECT_TIMEOUT_MS=10000
MCP_TOOL_TIMEOUT_MS=30000
#  등록된 서버 재탐색 주기 · 확인 주기(0 이면 주기 잡 끔)
MCP_SYNC_INTERVAL_SEC=3600
MCP_SYNC_TICK_SEC=60

WORKER_CONCURRENCY=5

# Agent Runtime: loop = Agent Loop(LLM 호출), placeholder = LLM 없이 파이프라인만 확인하는 고정 응답
AGENT_RUNTIME=loop
# LLM 호출: 응답 대기(스트림은 첫 응답까지) · 스트림 청크 간 대기 · 429/5xx/네트워크 재시도 횟수
LLM_REQUEST_TIMEOUT_MS=120000
LLM_IDLE_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# placeholder 런타임의 스트리밍 간격
PLACEHOLDER_STREAM_DELAY_MS=40
