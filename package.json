{
  "name": "theoneai",
  "version": "0.1.0",
  "description": "Embedded AI Agent Widget — NestJS API & agent worker",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\" \"apps/**/*.{ts,tsx,css}\"",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pretest:e2e": "npm run build:ui",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "dev:pack-skill": "tsx scripts/pack-skill.ts",
    "dev:mcp-server": "tsx scripts/dev-mcp-server.ts",
    "dev:identity-token": "tsx scripts/mint-identity-token.ts",
    "dev:admin-password": "tsx scripts/set-admin-password.ts",
    "postinstall": "prisma generate",
    "build:widget": "vite build --config apps/widget/vite.config.ts",
    "build:console": "vite build --config apps/console/vite.config.ts",
    "build:ui": "npm run build:widget && npm run build:console",
    "typecheck:ui": "tsc --noEmit -p apps/widget/tsconfig.json && tsc --noEmit -p apps/console/tsconfig.json",
    "ui:check": "node scripts/sync-shadcn-nova.mjs --check",
    "ui:sync": "node scripts/sync-shadcn-nova.mjs --refresh --write",
    "dev:widget": "vite build --watch --config apps/widget/vite.config.ts",
    "dev:console": "vite --config apps/console/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "bullmq": "6.5.1",
    "dotenv": "18.0.9",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "react-resizable-panels": "4.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "7.30.1",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "yazl": "3.3.1"
  }
}
